# ================================================================ scan
def scan_file(p):
    try:
        if os.path.getsize(p) > MAX_SIZE:
            return None
        text = open(p, "rb").read().decode("utf-8", "ignore")
    except OSError:
        return None
    if text.lstrip()[:40].startswith(NOISE_PREFIX):
        return None
    low = text.lower()
    hits = {}

    for name, needles, rx, _ in DET:
        if needles and not any((n[1:] in low) if n[0] == "~" else (n in text) for n in needles):
            continue
        vals = {m.group(1) for m in rx.finditer(text)}
        vals = {v for v in vals if not PLACEHOLDER.match(v)
                and (name in NO_ENTROPY or entropy(v) >= MIN_ENTROPY)}
        if name in VALIDATORS:
            vals = {v for v in vals if VALIDATORS[name](v)}
        if name == "private_key":
            vals = {p for p in map(pem_normalize, vals) if p}
        if name == "aws_other_id":  # CloudFront Key-Pair-Id is printed in every signed URL
            kp = {v for v in vals if f"Key-Pair-Id={v}" in text}
            if kp:
                hits["cloudfront_keypair_id"] = kp
                vals -= kp
        if vals:
            hits[name] = vals
    hits.update(composite_hits(text, low))

    for name, (needles, rx) in PAIR_RX.items():
        hay = low if name in PAIR_CASE_INSENSITIVE else text
        if any(n in hay for n in needles):
            vals = {m.group(1) for m in rx.finditer(text) if not PLACEHOLDER.match(m.group(1))}
            if vals:
                hits[name] = vals

    generic = []
    if GENERIC and any(k in low for k in GENERIC_KEYS):
        for m in GENERIC_RX.finditer(text):
            k, v = m.group(1), m.group(2)
            if PLACEHOLDER.match(v) or GENERIC_SKIP.search(v) or GENERIC_SKIP_CS.search(v) or v.isalpha():
                continue
            if v in KNOWN_PUBLIC or v.lower() == k.lower().split(".")[-1].lower():
                continue
            if not (any(c.isdigit() for c in v) and any(c.isalpha() for c in v)):
                continue
            if entropy(v) >= 3.5:
                generic.append((k, v))

    hosts = set(HOST_RX.findall(low)) if HOST_RX else set()
    if hits or generic or hosts:
        return (p, hits, generic, context_tag(text), hosts)
    return None


def scan(root):
    from concurrent.futures import ProcessPoolExecutor
    paths = []
    for dp, dirs, fs in os.walk(root):
        dirs[:] = [d for d in dirs if d not in EXCLUDE]
        paths += [os.path.join(dp, f) for f in fs]
    out, n = [], len(paths)
    with ProcessPoolExecutor() as ex:
        for i, r in enumerate(ex.map(scan_file, paths, chunksize=64), 1):
            if r:
                out.append(r)
            if i % 500 == 0 or i == n:
                print(f"\r[scan] {i}/{n} files, {len(out)} with candidates",
                      end="", file=sys.stderr, flush=True)
    print(file=sys.stderr)
    return out


def build_jobs(per_file):
    jobs = {}
    for p, h, _, ctx, _hosts in per_file:
        src = (p, ctx)
        for k in h.get("aws_key_id", ()):
            for sec in (h.get("aws_secret") or {None}):
                jobs.setdefault(("aws", k, sec), src)
        for c in h.get("g_client", ()):
            for sec in (h.get("g_secret") or {None}):
                jobs.setdefault(("google_oauth", c, sec), src)
        for name in [d[0] for d in DETECTORS] + list(COMPOSITE_CHECKS):
            if name == "aws_key_id":
                continue
            for v in h.get(name, ()):
                key = (name, v, None)
                if key not in jobs or (jobs[key][1] and not ctx):
                    jobs[key] = src
    return jobs


