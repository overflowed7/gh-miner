def write_generic(per_file):
    seen = {}
    for p, _, gen, _ctx, _hosts in per_file:
        for k, v in gen:
            if v not in seen:
                seen[v] = [k, p, 0]
            seen[v][2] += 1
    rows = sorted(seen.items(), key=lambda x: -entropy(x[0]))
    with open("generic_candidates.tsv", "w") as f:
        f.write("entropie\toccurrences\tnom\tvaleur\tfichier\n")
        for v, (k, p, n) in rows:
            f.write(f"{entropy(v):.2f}\t{n}\t{k}\t{v}\t{p}\n")
    return len(rows)


# ================================================================ private-key triage
# Automates the manual steps: full SPKI fingerprint, comparison with the key
# actually served by target hosts, and crt.sh lookup. Keys are never used:
# only their PUBLIC half is compared to public data.
CRTSH_CACHE = os.path.expanduser("~/.cache/check-leaks/crtsh.json")
CRTSH_TTL = 7 * 86400


def spki_of_private(pem):
    from cryptography.hazmat.primitives import serialization as s
    k = s.load_ssh_private_key(pem.encode(), None) if "OPENSSH" in pem \
        else s.load_pem_private_key(pem.encode(), None)
    return hashlib.sha256(k.public_key().public_bytes(
        s.Encoding.DER, s.PublicFormat.SubjectPublicKeyInfo)).hexdigest()


def live_spki(target):
    """SPKI sha256 of the leaf certificate served by host[:port], or None if unreachable."""
    import ssl
    from cryptography import x509
    from cryptography.hazmat.primitives import serialization as s
    host, _, port = target.partition(":")
    ctx = ssl.create_default_context()
    ctx.check_hostname, ctx.verify_mode = False, ssl.CERT_NONE  # we only read the cert
    try:
        with socket.create_connection((host, int(port or 443)), timeout=6) as raw, \
                ctx.wrap_socket(raw, server_hostname=host) as tls:
            der = tls.getpeercert(binary_form=True)
    except (OSError, ValueError):
        return None
    if not der:
        return None
    pub = x509.load_der_x509_certificate(der).public_key()
    return hashlib.sha256(pub.public_bytes(s.Encoding.DER, s.PublicFormat.SubjectPublicKeyInfo)).hexdigest()


def _load_cache():
    try:
        with open(CRTSH_CACHE) as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


def _save_cache(cache):
    try:
        os.makedirs(os.path.dirname(CRTSH_CACHE), exist_ok=True)
        with open(CRTSH_CACHE, "w") as f:
            json.dump(cache, f)
    except OSError:
        pass


def crtsh_lookup(fp, cache):
    """Certificates issued for this SPKI (list of dicts) or None if crt.sh never answered."""
    import requests
    hit = cache.get(fp)
    if hit and time.time() - hit["t"] < CRTSH_TTL:
        return hit["certs"]
    for attempt in range(4):
        try:
            r = requests.get(f"https://crt.sh/?spkisha256={fp}&output=json", timeout=60)
            if r.status_code == 200:
                certs = [{k: c.get(k) for k in ("id", "issuer_name", "common_name", "name_value",
                                                "not_before", "not_after")} for c in r.json()]
                cache[fp] = {"t": time.time(), "certs": certs}
                return certs
        except Exception:
            pass
        time.sleep(10 * (attempt + 1))
    return None


def _is_target(name):
    name = name.lower().lstrip("*.")
    return any(name == d or name.endswith("." + d) for d in DOMAINS)


def pk_triage(results, hosts):
    keys = [r for r in results if r["type"] == "private_key" and r["state"] == "MANUAL"]
    if not keys:
        return
    for r in keys:
        try:
            r["spki"] = spki_of_private(r["value"])
        except Exception:
            r["spki"] = None

    # 1) is the key served right now by one of the target hosts?
    if hosts:
        from concurrent.futures import ThreadPoolExecutor
        print(f"[pk] fetching live TLS keys of {len(hosts)} hosts…", file=sys.stderr)
        with ThreadPoolExecutor(20) as ex:
            live = dict(zip(hosts, ex.map(live_spki, hosts)))
        served = {}
        for h, fp in live.items():
            if fp:
                served.setdefault(fp, []).append(h)
        n_ok = sum(1 for v in live.values() if v)
        print(f"[pk] {n_ok}/{len(hosts)} hosts answered TLS", file=sys.stderr)
        for r in keys:
            if r["spki"] in served:
                r["state"] = "DEPLOYED"
                r["info"] = f"spki={r['spki'][:16]} SERVED NOW by {', '.join(served[r['spki']][:3])} — stop, report, do not use the key"

    # 2) has a public certificate ever been issued for this key?
    if not CRTSH:
        return
    todo = [r for r in keys if r["state"] == "MANUAL" and r["spki"] and (PK_ALL or not r["ctx"])]
    if not todo:
        return
    cache = _load_cache()
    print(f"[pk] crt.sh lookup for {len(todo)} keys (cache: {CRTSH_CACHE})", file=sys.stderr)
    now = time.strftime("%Y-%m-%dT%H:%M:%S", time.gmtime())
    for i, r in enumerate(todo, 1):
        cached = r["spki"] in cache
        certs = crtsh_lookup(r["spki"], cache)
        print(f"\r[pk] {i}/{len(todo)}", end="", file=sys.stderr, flush=True)
        if not cached:
            _save_cache(cache)
            time.sleep(2)
        if certs is None:
            r["info"] += " | crt.sh: no answer, rerun later (cached results are kept)"
            continue
        if not certs:
            r["state"], r["info"] = "NO_PUBLIC_CERT", r["info"].split(" → ")[0] + " — never used for a public certificate"
            continue
        names = sorted({n for c in certs for n in (c.get("name_value") or "").split("\n") if n})
        valid = [c for c in certs if (c.get("not_after") or "") > now]
        target = [n for n in names if _is_target(n)]
        summary = f"{len(certs)} certs ({len(valid)} valid) names={names[:3]} issuer={certs[0].get('issuer_name', '')[:60]}"
        if target and valid:
            r["state"], r["info"] = "CERT_TARGET", f"spki={r['spki'][:16]} VALID certificate for target domain {target[:3]} — {summary}"
        elif valid:
            r["state"], r["info"] = "CERT_LIVE", f"spki={r['spki'][:16]} valid cert, not on target domains (third party?) — {summary}"
        else:
            r["state"], r["info"] = "CERT_EXPIRED", f"spki={r['spki'][:16]} only expired certs — {summary}"
    print(file=sys.stderr)
    _save_cache(cache)


def main():
    per_file = scan(ROOT)
    jobs = build_jobs(per_file)
    print(f"[*] {len(per_file)} files with candidates, {len(jobs)} unique tests\n")

    results = []
    for (kind, val, sec), (path, ctx) in jobs.items():
        chk = CHECKS[kind]
        if isinstance(chk, str):
            state, info = chk, HINTS.get(kind, "")
        elif OFFLINE and kind not in LOCAL_ONLY:
            state, info = "SKIPPED", "--offline"
        else:
            try:
                state, info = chk(val, sec) if kind in PAIRED else chk(val)
            except Exception as e:
                state, info = "ERROR", repr(e)[:80]
            if kind not in ("jwt", "private_key"):
                time.sleep(0.3)
        results.append({"type": kind, "value": val, "secret": sec,
                        "state": state, "info": info, "file": path, "ctx": ctx})

    # one key (PKCS#1, PKCS#8, pasted in code…) = one line
    by_fp, kept = {}, []
    for r in results:
        m = re.match(r"spki_sha256=(\w+)", r["info"]) if r["type"] == "private_key" else None
        if not m:
            kept.append(r)
            continue
        prev = by_fp.get(m.group(1))
        if prev is None:
            r["dups"] = 1
            by_fp[m.group(1)] = r
            kept.append(r)
        else:
            prev["dups"] += 1
            if prev["ctx"] and not r["ctx"]:
                prev.update(file=r["file"], ctx="")
    for r in by_fp.values():
        if r["dups"] > 1:
            r["info"] += f" (×{r['dups']} formats/files)"
    results = kept

    if not OFFLINE:
        hosts = list(HOSTS)
        if DOMAINS:
            found = sorted({h for item in per_file for h in item[4]})
            hosts += [h for h in found if h not in hosts][:300]
            print(f"[pk] {len(found)} hostnames under {DOMAINS} collected from the dump", file=sys.stderr)
        pk_triage(results, hosts)

    rank = {s: i for i, s in enumerate(ORDER)}
    # for equal state, test / vendored files go last
    results.sort(key=lambda r: (rank.get(r["state"], 99), r["ctx"] != "", r["type"]))
    for r in results:
        flag = "🔥" if r["state"] in FLAG else "  "
        print(f"{flag} {r['state']:14} {r['type']:18} {r['ctx']:6} {mask(r['value'], r['type']):38} "
              f"{mask(r['secret'] or ''):20} {r['info']}")

    with open("leaks_checked.json", "w") as f:
        json.dump(results, f, indent=2)
    summary = Counter(r["state"] for r in results)
    print("\n[*] " + "  ".join(f"{s}={summary[s]}" for s in ORDER if summary[s]))
    print("[*] Details: leaks_checked.json")
    if GENERIC:
        n = write_generic(per_file)
        print(f"[*] {n} generic values to review: generic_candidates.tsv "
              f"(column -t -s$'\\t' generic_candidates.tsv | less -S)")


if __name__ == "__main__":
    main()
