    r"^(pass(word)?\d*|secret|changeme|change_?me|root|admin|test\w*|postgres|mysql|mongo|redis|"
    r"guest|user|pwd|example|dbpass|mypass\w*|\$.*|<.*|%.*|\{.*|\*+|x+|\.+)$", re.I)
