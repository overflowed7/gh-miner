def _azure_conn(cs):
    f = dict(p.split("=", 1) for p in cs.strip(";").split(";") if "=" in p)
    return f.get("AccountName"), f.get("AccountKey"), f


def chk_azure_conn(cs):
    """SharedKey-signed Get Blob Service Properties: config read, HTTP status only."""
    import requests
    acct, key, f = _azure_conn(cs)
    if not acct or not key:
        return "MANUAL", "AccountName or AccountKey missing"
    if acct == "devstoreaccount1" or key == AZURITE_KEY:
        return "PUBLIC", "Azurite / emulator key (public)"
    base = f.get("BlobEndpoint") or \
        f"{f.get('DefaultEndpointsProtocol', 'https')}://{acct}.blob.{f.get('EndpointSuffix', 'core.windows.net')}"
    base = base.rstrip("/")
    path = urlsplit(base).path  # emulator: /devstoreaccount1
    date, ver = formatdate(usegmt=True), "2021-08-06"
    sts = "GET\n" + "\n" * 11 + f"x-ms-date:{date}\nx-ms-version:{ver}\n" \
          f"/{acct}{path}/\ncomp:properties\nrestype:service"
    try:
        sig = base64.b64encode(hmac.new(base64.b64decode(key), sts.encode(),
                                        hashlib.sha256).digest()).decode()
    except Exception:
        return "UNPARSEABLE", "AccountKey non base64"
    try:
        c = requests.get(f"{base}/?restype=service&comp=properties", timeout=10, headers={
            "x-ms-date": date, "x-ms-version": ver,
            "Authorization": f"SharedKey {acct}:{sig}"}).status_code
    except requests.exceptions.ConnectionError:
        return "DEAD", f"account {acct} does not exist (DNS)"
    if c == 200:
        return "VALID", f"account={acct} key active"
    if c == 403:
        return "DEAD", f"account={acct} exists, key revoked or wrong"
    return "UNKNOWN", f"HTTP {c}"


def chk_azure_sas(url):
    import requests
    url = url.replace("&amp;", "&").replace("\\u0026", "&")
    u = urlsplit(url)
    q = {k: v[0] for k, v in parse_qs(u.query).items()}
    se, sp = q.get("se", ""), q.get("sp", "?")
    info = f"account={u.hostname.split('.')[0]} sp={sp} se={se or '-'}"
    if se:
        try:
            t = time.mktime(time.strptime(se[:19].rstrip("Z"), "%Y-%m-%dT%H:%M:%S"))
            if t < time.time():
                return "EXPIRED", info
        except ValueError:
            try:
                if time.mktime(time.strptime(se[:10], "%Y-%m-%d")) < time.time():
                    return "EXPIRED", info
            except ValueError:
                pass
    if u.path in ("", "/"):
        return "MANUAL", info + " (unexpired account SAS: no HEAD without a resource path)"
    if OFFLINE:
        return "NOT_EXPIRED", info
    # HEAD: metadata only, no content downloaded
    try:
        c = requests.head(url, timeout=10).status_code
    except requests.exceptions.ConnectionError:
        return "DEAD", info + " (DNS)"
    if c == 200:
        return "VALID", info
    if c in (403, 404):
        return "DEAD", info + f" HTTP {c}"
    return "UNKNOWN", info + f" HTTP {c}"


# ---------------------------------------------------------------- GCP service accounts
def chk_gcp_sa(pair):
    """Public x509 endpoint: no authentication, the key is never used."""
    import requests
    email, kid = pair.split("|", 1)
    r = requests.get(f"https://www.googleapis.com/service_accounts/v1/metadata/x509/{email}",
                     timeout=10)
    if r.status_code == 404:
        return "DEAD", f"{email}: service account deleted"
    if r.status_code != 200:
        return "UNKNOWN", f"HTTP {r.status_code}"
    if kid in r.json():
        return "VALID", f"{email}: key_id {kid[:8]}… ACTIVE (public x509 check)"
    return "DEAD", f"{email} exists, key {kid[:8]}… revoked"


# ---------------------------------------------------------------- Okta / Discord
def chk_okta(pair):
    dom, tok = pair.split("|", 1)
    if dom == "?":
        return "MANUAL", "SSWS token without an Okta domain in the file: GET https://<org>.okta.com/api/v1/users/me"
    return http("GET", f"https://{dom}/api/v1/users/me",
                headers={"Authorization": f"SSWS {tok}", "Accept": "application/json"})


def discord_bot_ok(t):
    """The first segment of a bot token is the bot user id (17-20 digits) in base64."""
    seg = t.split(".")[0]
    try:
        uid = base64.b64decode(seg + "=" * (-len(seg) % 4)).decode()
    except Exception:
        return False
    return uid.isdigit() and 17 <= len(uid) <= 20


def chk_discord_hook(url):
    # GET on a webhook returns its metadata, nothing is posted
    import requests
    r = requests.get(url, timeout=10)
    if r.status_code == 200:
        j = r.json()
        return "VALID", f"webhook active guild={j.get('guild_id')} channel={j.get('channel_id')}"
    return "DEAD", f"HTTP {r.status_code}"


