def composite_hits(text, low):
    out = {}
    if '"service_account"' in text:
        emails = [(m.start(), m.group(1)) for m in GCP_SA_EMAIL.finditer(text)]
        for m in GCP_SA_KID.finditer(text):  # client_email closest to this key id
            if emails:
                e = min(emails, key=lambda x: abs(x[0] - m.start()))[1]
                out.setdefault("gcp_sa", set()).add(f"{e}|{m.group(1)}")
    if "okta" in low or "ssws" in low:
        toks = {m.group(1) for m in OKTA_TOKEN.finditer(text)}
        doms = {d.lower() for d in OKTA_DOMAIN.findall(text)} or {"?"}
        out.update({"okta": {f"{d}|{t}" for d in doms for t in toks}} if toks else {})
    return out


