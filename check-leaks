def entropy(s):
    n = len(s)
    return -sum(c / n * math.log2(c / n) for c in Counter(s).values()) if n else 0.0


def mask(v, kind=""):
    if kind == "private_key":
        return re.search(r"BEGIN (.*?)-----", v).group(1)
    if kind in ("gcp_sa", "okta"):
        a, b = v.split("|", 1)
        return f"{a[:24]}|{mask(b)}"
    if kind == "db_uri":  # hide the password
        return re.sub(r"(://[^:@/]*:)[^@]+@", r"\1***@", v)[:38]
    return v if not v or len(v) < 14 else f"{v[:14]}…{v[-4:]}"


# ================================================================ checks
def bearer(t):
    return {"Authorization": f"Bearer {t}"}


def http(method, url, ok=(200,), dead=(401,), **kw):
    """Identity call: only the HTTP status is looked at."""
    import requests
    kw.setdefault("timeout", 10)
    c = requests.request(method, url, **kw).status_code
    if c in ok:
        return "VALID", f"HTTP {c}"
    if c in dead:
        return "DEAD", f"HTTP {c}"
    if c == 403:
        return "MAYBE", "HTTP 403: key recognised but missing permissions? check manually"
    return "UNKNOWN", f"HTTP {c}"


def chk_aws(key_id, secret):
    import boto3, botocore
    try:
        r = boto3.client("sts", region_name="us-east-1", aws_access_key_id=key_id,
                         aws_secret_access_key=secret or "A" * 40).get_caller_identity()
        return "VALID", r["Arn"]
    except botocore.exceptions.ClientError as e:
        code = e.response["Error"]["Code"]
        if code == "SignatureDoesNotMatch":
            return "KEYID_ACTIVE", "key ID active, secret wrong or missing"
        if code == "InvalidClientTokenId":
            return "DEAD", code
        return "UNKNOWN", code


def chk_google_oauth(cid, secret):
    import requests
    j = requests.post("https://oauth2.googleapis.com/token", timeout=10, data={
        "client_id": cid, "client_secret": secret or "x",
        "grant_type": "authorization_code", "code": "invalid",
        "redirect_uri": "http://localhost"}).json()
    err, desc = j.get("error"), j.get("error_description", "")
    if err == "invalid_grant":
        return "VALID", "paire client_id/secret active"
    if err == "deleted_client":
        return "DEAD", "client deleted"
    if err == "invalid_client" and "Unauthorized" in desc:
        return "CLIENT_EXISTS", "client active, secret wrong or missing"
    return "DEAD", f"{err}: {desc}"


def chk_google_token(t):
    import requests
    c = requests.get("https://oauth2.googleapis.com/tokeninfo",
                     params={"access_token": t}, timeout=10).status_code
    return ("VALID", "HTTP 200") if c == 200 else ("DEAD", f"HTTP {c}")


def chk_github(t):
