    r"^(localhost|.*\.local|.*\.localhost|.*\.internal|.*\.svc(\.cluster\.local)?|"
    r"host\.docker\.internal|.*example\.(com|org|net)|.*\.test|.*\.invalid)$", re.I)


def db_parse(uri):
    scheme, rest = uri.split("://", 1)
    cred, _, hostpart = rest.rpartition("@")
    user, _, pw = cred.partition(":")
    first = re.split(r"[,/?]", hostpart, maxsplit=1)[0]
    host, _, port = first.partition(":")
    if host.startswith("["):  # IPv6
        host, _, port = first[1:].partition("]:")
    return scheme.lower(), unquote(user), unquote(pw), host.lower(), \
        int(port) if port.isdigit() else DB_PORTS.get(scheme.lower(), 0)


def chk_db_uri(uri):
    """DNS + connexion TCP nue : AUCUNE tentative d'authentification."""
    scheme, user, pw, host, port = db_parse(uri)
    info = f"{scheme} {user}@{host}:{port}"
    if not pw or DB_PW_PLACEHOLDER.match(pw) or len(pw) < 4:
        return "FIXTURE", info + " (placeholder password)"
    try:
        if ipaddress.ip_address(host).is_private or ipaddress.ip_address(host).is_loopback:
            return "LOCAL", info + " (private IP)"
    except ValueError:
        if "." not in host or LOCAL_HOST.match(host):
            return "LOCAL", info + " (local / docker / example host)"
    if OFFLINE:
        return "SKIPPED", info
    targets = [(host, port)]
    if scheme == "mongodb+srv":
        try:
            import dns.resolver
            ans = dns.resolver.resolve(f"_mongodb._tcp.{host}", "SRV", lifetime=5)
            targets = [(str(a.target).rstrip("."), a.port) for a in ans]
        except Exception as e:
            return "UNREACHABLE", info + f" (no SRV record: {type(e).__name__})"
    for h, p in targets[:3]:
        try:
            socket.getaddrinfo(h, p)
        except socket.gaierror:
            continue
        try:
            socket.create_connection((h, p), timeout=4).close()
            return "REACHABLE", info + f" port open ({h}:{p}) — auth NOT tested"
        except OSError:
            pass
    return "UNREACHABLE", info + " (DNS failure or filtered port; may sit behind a VPN)"


# ---------------------------------------------------------------- private keys
def pem_normalize(block):
    """Rebuild a key pasted into code (escaped \\n, diff prefixes, quotes)."""
    block = block.replace("\\n", "\n").replace("\\r", "")
    raw = [l.strip() for l in block.splitlines() if l.strip()]
    # diff prefix only if EVERY line has it (a base64 line may start with '+')
    # (first line excluded: the match starts at -----BEGIN, after the prefix)
    diff = len(raw) > 2 and all(l[:1] in "+-" and not l.startswith("-----") for l in raw[1:])
    lines = []
    for i, l in enumerate(raw):
        if diff and i > 0:
            l = l[1:].strip()
        l = re.sub(r"""["'`]\s*\+?\s*[,;)]*\s*$""", "", l)      # end:  "...", / "..." +
        l = re.sub(r"""^\s*\+?\s*["'`]""", "", l)               # start: + "...
        l = l.rstrip("\\").strip("\"'` ")
        if l:
            lines.append(l)
    head = next((l for l in lines if l.startswith("-----BEGIN")), "")
    m = re.search(r"-----BEGIN (.*?PRIVATE KEY)-----", head)
    if not m:
        return None
    kind = m.group(1)
    hdrs = [l for l in lines if ":" in l and not l.startswith("-----")]  # Proc-Type, DEK-Info
    body = "".join(l for l in lines if not l.startswith("-----") and ":" not in l)
    body = re.sub(r"[^A-Za-z0-9+/=]", "", body)
    wrapped = "\n".join(body[i:i + 64] for i in range(0, len(body), 64))
    extra = ("\n".join(hdrs) + "\n\n") if hdrs else ""
    return f"-----BEGIN {kind}-----\n{extra}{wrapped}\n-----END {kind}-----\n"


def chk_private_key(pem):
    from cryptography.hazmat.primitives import serialization as s
    kind = re.match(r"-----BEGIN (.*)-----", pem).group(1)
    if "ENCRYPTED" in kind or "Proc-Type: 4,ENCRYPTED" in pem:
        return "ENCRYPTED", f"{kind} encrypted (passphrase required): almost always a fixture"
    try:
        k = s.load_ssh_private_key(pem.encode(), None) if "OPENSSH" in kind \
            else s.load_pem_private_key(pem.encode(), None)
    except Exception as e:
        return "UNPARSEABLE", f"{kind}: {type(e).__name__} (truncated / concatenated?)"
    spki = k.public_key().public_bytes(s.Encoding.DER, s.PublicFormat.SubjectPublicKeyInfo)
    fp = hashlib.sha256(spki).hexdigest()
    return "MANUAL", f"spki_sha256={fp[:16]} {type(k).__name__.replace('_PrivateKey', '')} " \
                     "→ compare with deployed certs (crt.sh / live TLS)"


def chk_jwt(tok):
    def dec(s):
        return json.loads(base64.urlsafe_b64decode(s + "=" * (-len(s) % 4)))
    try:
        h, p = (dec(x) for x in tok.split(".")[:2])
    except Exception:
        return "UNPARSEABLE", ""
    exp = p.get("exp")
    state = "NO_EXP" if not exp else ("EXPIRED" if exp < time.time() else "NOT_EXPIRED")
    try:
        exp_s = time.strftime("%Y-%m-%d", time.gmtime(exp)) if exp else "-"
    except (OverflowError, OSError, ValueError):
        exp_s = str(exp)
    return state, f"alg={h.get('alg')} iss={p.get('iss')} sub={p.get('sub')} exp={exp_s}"


