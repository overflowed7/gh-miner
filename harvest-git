#!/bin/bash
# Unshallow chaque repo cloné puis lance git-dump dessus.
# Usage: ./harvest-all.sh [base_dir]
set -u
BASE_DIR="${1:-.}"
cd "$BASE_DIR"

for repo in */; do
    repo="${repo%/}"
    [ -d "$repo/.git" ] || continue
    echo "=== $repo ==="
    (
        cd "$repo"
        if [ "$(git rev-parse --is-shallow-repository 2>/dev/null)" = "true" ]; then
            git fetch --unshallow --tags --quiet 2>&1 | tail -3
        fi
        git fetch origin '+refs/heads/*:refs/remotes/origin/*' --quiet 2>&1 | tail -3
        rm -rf git-objects
        git-dump git-objects
        n=$(find git-objects -type f | wc -l)
        echo "  -> $n objets extraits"
    )
done
